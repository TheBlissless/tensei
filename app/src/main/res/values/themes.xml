<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- windowBackground follows the DayNight parent (light in day, dark in night) so the
         launch flash matches the system theme; a hardcoded black flashed dark in light mode.
         The Compose AppTheme surface takes over right after the first frame. -->
    <style name="Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.App.Launch" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>